{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/classify",
      "destination": "/classify.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/history",
      "destination": "/history.html"
    },
    {
      "source": "/awareness",
      "destination": "/awareness.html"
    },
    {
      "source": "/sample/:file",
      "destination": "/sample_test_images/:file"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
